<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><section class="panel"><div class="toolbar"><span>Horario académico</span><a class="button" href="${pageContext.request.contextPath}/horarios/nuevo">Nuevo horario</a></div><table><tr><th>Curso</th><th>Asignatura</th><th>Docente</th><th>Día</th><th>Hora</th><th>Acciones</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("items")){%><tr><td><%=x.get("curso")%></td><td><%=x.get("asignatura")%></td><td><%=x.get("docente")%></td><td><%=x.get("dia")%></td><td><%=x.get("hora_inicio")%> - <%=x.get("hora_fin")%></td><td><a class="button secondary" href="${pageContext.request.contextPath}/horarios/editar?id=<%=x.get("id")%>">Editar</a> <form style="display:inline" method="post" action="${pageContext.request.contextPath}/horarios/eliminar"><input type="hidden" name="id" value="<%=x.get("id")%>"><button class="danger">Eliminar</button></form></td></tr><%}%></table><p>Regla: un docente no puede superar 8 horas al día y no se permiten cruces de docente o curso.</p></section><%@ include file="../fragments/footer.jspf" %>
