<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><section class="panel"><div class="toolbar"><span>Lista de asignaturas</span><a class="button" href="${pageContext.request.contextPath}/asignaturas/nuevo">Nueva asignatura</a></div><table><tr><th>Nombre</th><th>Horas semanales</th><th>Acciones</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("items")){%><tr><td><%=x.get("nombre")%></td><td><%=x.get("intensidad_horaria")%></td><td><a class="button secondary" href="${pageContext.request.contextPath}/asignaturas/editar?id=<%=x.get("id")%>">Editar</a> <form style="display:inline" method="post" action="${pageContext.request.contextPath}/asignaturas/eliminar"><input type="hidden" name="id" value="<%=x.get("id")%>"><button class="danger">Eliminar</button></form></td></tr><%}%></table></section><%@ include file="../fragments/footer.jspf" %>
