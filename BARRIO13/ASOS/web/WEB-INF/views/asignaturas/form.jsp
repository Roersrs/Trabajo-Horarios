<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><% Map<String,Object>x=(Map<String,Object>)request.getAttribute("asignatura"); %><section class="panel"><form class="grid" method="post" action="${pageContext.request.contextPath}/asignaturas/guardar"><input type="hidden" name="id" value="<%=x.getOrDefault("id","")%>"><div class="field"><label>Nombre</label><input name="nombre" required value="<%=x.getOrDefault("nombre","")%>"></div><div class="field"><label>Intensidad horaria semanal</label><input type="number" min="1" max="40" name="intensidad_horaria" required value="<%=x.getOrDefault("intensidad_horaria",2)%>"></div><div class="form-actions"><button>Guardar</button> <a class="button secondary" href="${pageContext.request.contextPath}/asignaturas">Cancelar</a></div></form></section><%@ include file="../fragments/footer.jspf" %>
