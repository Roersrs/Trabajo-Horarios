<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><% Map<String,Object>x=(Map<String,Object>)request.getAttribute("curso"); %><section class="panel"><form class="grid" method="post" action="${pageContext.request.contextPath}/cursos/guardar"><input type="hidden" name="id" value="<%=x.getOrDefault("id","")%>"><div class="field"><label>Grado</label><input name="grado" required value="<%=x.getOrDefault("grado","")%>"></div><div class="field"><label>Nombre</label><input name="nombre" required value="<%=x.getOrDefault("nombre","")%>"></div><div class="field"><label>Estudiantes</label><input type="number" min="1" name="numero_estudiantes" required value="<%=x.getOrDefault("numero_estudiantes",30)%>"></div><div class="field"><label>Jornada</label><select name="jornada_id" required><% for(Map<String,Object>j:(List<Map<String,Object>>)request.getAttribute("jornadas")){String sel=Objects.equals(String.valueOf(j.get("id")),String.valueOf(x.get("jornada_id")))?"selected":"";%><option value="<%=j.get("id")%>" <%=sel%>><%=j.get("nombre")%></option><%}%></select></div><div class="form-actions"><button>Guardar</button> <a class="button secondary" href="${pageContext.request.contextPath}/cursos">Cancelar</a></div></form></section><%@ include file="../fragments/footer.jspf" %>
