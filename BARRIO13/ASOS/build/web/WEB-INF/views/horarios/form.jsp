<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><% Map<String,Object>x=(Map<String,Object>)request.getAttribute("horario"); %><section class="panel"><form class="grid" method="post" action="${pageContext.request.contextPath}/horarios/guardar"><input type="hidden" name="id" value="<%=x.getOrDefault("id","")%>"><div class="field"><label>Curso</label><select name="curso_id" required><% for(Map<String,Object>v:(List<Map<String,Object>>)request.getAttribute("cursos")){String s=Objects.equals(String.valueOf(v.get("id")),String.valueOf(x.get("curso_id")))?"selected":"";%><option value="<%=v.get("id")%>" <%=s%>><%=v.get("grado")%> - <%=v.get("nombre")%></option><%}%></select></div><div class="field"><label>Asignatura</label><select name="asignatura_id" required><% for(Map<String,Object>v:(List<Map<String,Object>>)request.getAttribute("asignaturas")){String s=Objects.equals(String.valueOf(v.get("id")),String.valueOf(x.get("asignatura_id")))?"selected":"";%><option value="<%=v.get("id")%>" <%=s%>><%=v.get("nombre")%></option><%}%></select></div><div class="field"><label>Docente</label><select name="docente_id" required><% for(Map<String,Object>v:(List<Map<String,Object>>)request.getAttribute("docentes")){String s=Objects.equals(String.valueOf(v.get("id")),String.valueOf(x.get("docente_id")))?"selected":"";%><option value="<%=v.get("id")%>" <%=s%>><%=v.get("nombre")%></option><%}%></select></div><div class="field"><label>Día</label><select name="dia" required><% for(String d:List.of("Lunes","Martes","Miercoles","Jueves","Viernes")){String s=d.equals(String.valueOf(x.get("dia")))?"selected":"";%><option <%=s%>><%=d%></option><%}%></select></div><div class="field"><label>Hora inicio</label><input type="time" name="hora_inicio" required value="<%=x.getOrDefault("hora_inicio","07:00")%>"></div><div class="field"><label>Hora fin</label><input type="time" name="hora_fin" required value="<%=x.getOrDefault("hora_fin","08:00")%>"></div><div class="form-actions"><button>Guardar</button> <a class="button secondary" href="${pageContext.request.contextPath}/horarios">Cancelar</a></div></form></section><%@ include file="../fragments/footer.jspf" %>
