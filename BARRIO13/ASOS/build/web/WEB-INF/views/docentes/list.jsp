<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><section class="panel"><div class="toolbar"><span>Lista de docentes</span><a class="button" href="${pageContext.request.contextPath}/docentes/nuevo">Nuevo docente</a></div><table><tr><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Máx. horas/día</th><th>Acciones</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("items")){%><tr><td><%=x.get("nombre")%></td><td><%=x.get("correo")%></td><td><%=x.get("telefono")%></td><td><%=x.get("max_horas_diarias")%></td><td><a class="button" href="${pageContext.request.contextPath}/horario-docente?docente_id=<%=x.get("id")%>">Ver horario</a> <a class="button secondary" href="${pageContext.request.contextPath}/docentes/editar?id=<%=x.get("id")%>">Editar</a> <form style="display:inline" method="post" action="${pageContext.request.contextPath}/docentes/eliminar"><input type="hidden" name="id" value="<%=x.get("id")%>"><button class="danger">Eliminar</button></form></td></tr><%}%></table></section><%@ include file="../fragments/footer.jspf" %>
