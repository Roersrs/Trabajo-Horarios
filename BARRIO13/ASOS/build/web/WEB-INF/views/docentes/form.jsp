<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><% Map<String,Object>x=(Map<String,Object>)request.getAttribute("docente"); %><section class="panel"><form class="grid" method="post" action="${pageContext.request.contextPath}/docentes/guardar"><input type="hidden" name="id" value="<%=x.getOrDefault("id","")%>"><div class="field"><label>Nombre</label><input name="nombre" required value="<%=x.getOrDefault("nombre","")%>"></div><div class="field"><label>Correo</label><input type="email" name="correo" required value="<%=x.getOrDefault("correo","")%>"></div><div class="field"><label>Teléfono</label><input name="telefono" value="<%=x.getOrDefault("telefono","")%>"></div><div class="field"><label>Máximo horas por día</label><input type="number" min="1" max="8" name="max_horas_diarias" required value="<%=x.getOrDefault("max_horas_diarias",8)%>"></div><div class="form-actions"><button>Guardar</button> <a class="button secondary" href="${pageContext.request.contextPath}/docentes">Cancelar</a></div></form></section><%@ include file="../fragments/footer.jspf" %>
