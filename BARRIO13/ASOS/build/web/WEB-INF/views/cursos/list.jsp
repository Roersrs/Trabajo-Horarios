<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ include file="../fragments/header.jspf" %><section class="panel"><div class="toolbar"><span>Lista de cursos</span><a class="button" href="${pageContext.request.contextPath}/cursos/nuevo">Nuevo curso</a></div><table><tr><th>Grado</th><th>Curso</th><th>Jornada</th><th>Estudiantes</th><th>Acciones</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("items")){%><tr><td><%=x.get("grado")%></td><td><%=x.get("nombre")%></td><td><%=x.get("jornada")%></td><td><%=x.get("numero_estudiantes")%></td><td><a class="button secondary" href="${pageContext.request.contextPath}/cursos/editar?id=<%=x.get("id")%>">Editar</a> <form style="display:inline" method="post" action="${pageContext.request.contextPath}/cursos/eliminar"><input type="hidden" name="id" value="<%=x.get("id")%>"><button class="danger">Eliminar</button></form></td></tr><%}%></table></section><%@ include file="../fragments/footer.jspf" %>
