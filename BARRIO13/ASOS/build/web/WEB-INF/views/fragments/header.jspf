<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${pageTitle} | BARRIO 13</title>
<style>
:root{
  --negro:#090909;
  --carbon:#111214;
  --gris:#1c1e22;
  --borde:#31343a;
  --texto:#f4f4f4;
  --muted:#b7bbc2;
  --acento:#f2c94c;
  --acento2:#d8a900;
  --peligro:#d63b3b;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:
    linear-gradient(rgba(0,0,0,.78),rgba(0,0,0,.88)),
    repeating-linear-gradient(135deg,#161616 0,#161616 12px,#101010 12px,#101010 24px);
  color:var(--texto);
  min-height:100vh;
}
.top{
  background:#080808;
  color:#fff;
  padding:15px 24px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:3px solid var(--acento);
  box-shadow:0 4px 18px rgba(0,0,0,.55);
  position:sticky;
  top:0;
  z-index:10;
}
.brand{
  font-weight:900;
  letter-spacing:3px;
  font-size:20px;
  text-transform:uppercase;
}
.brand span{color:var(--acento)}
.top nav{display:flex;flex-wrap:wrap;gap:6px}
.top a{
  color:#e9e9e9;
  text-decoration:none;
  padding:8px 10px;
  border-radius:4px;
  font-weight:700;
  font-size:14px;
  transition:.18s;
}
.top a:hover{background:var(--acento);color:#080808}
.wrap{max-width:1120px;margin:28px auto;padding:0 18px}
h1{
  text-transform:uppercase;
  letter-spacing:2px;
  margin:0 0 20px;
  padding-left:13px;
  border-left:5px solid var(--acento);
  font-size:30px;
}
.panel{
  background:rgba(19,20,23,.97);
  border:1px solid var(--borde);
  border-radius:8px;
  padding:22px;
  box-shadow:0 14px 35px rgba(0,0,0,.35);
}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}
.button,button{
  display:inline-block;
  background:var(--acento);
  color:#080808;
  border:0;
  border-radius:4px;
  padding:10px 14px;
  text-decoration:none;
  cursor:pointer;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.button:hover,button:hover{background:#ffd85e}
.secondary{background:#3b3e44;color:#fff}
.secondary:hover{background:#4d5159;color:#fff}
.danger{background:var(--peligro);color:#fff}
.danger:hover{background:#ee4b4b;color:#fff}
table{width:100%;border-collapse:collapse;background:#141519}
th,td{border-bottom:1px solid #2d3035;padding:11px;text-align:left}
th{
  color:var(--acento);
  background:#0d0e10;
  text-transform:uppercase;
  letter-spacing:.6px;
  font-size:13px;
}
tr:hover td{background:#1b1d21}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.field label{display:block;font-weight:800;margin-bottom:7px;color:#dedede}
.field input,.field select{
  width:100%;
  padding:11px;
  color:#fff;
  background:#0d0e10;
  border:1px solid #3b3e44;
  border-radius:4px;
  outline:none;
}
.field input:focus,.field select:focus{border-color:var(--acento);box-shadow:0 0 0 2px rgba(242,201,76,.12)}
.form-actions{grid-column:1/-1;display:flex;gap:8px;margin-top:5px}
.error{background:#351717;color:#ffb7b7;border:1px solid #7e2b2b;padding:12px;border-radius:5px;margin-bottom:15px}
a{color:var(--acento)}
p{color:#d2d3d6}
@media(max-width:700px){
  .grid{grid-template-columns:1fr}
  .top{display:block}
  .top nav{margin-top:12px}
  .wrap{margin-top:20px}
}
</style>
</head>
<body>
<header class="top">
  <div class="brand">BARRIO 13 <span>//</span></div>
  <nav>
    <a href="${pageContext.request.contextPath}/dashboard">Inicio</a>
    <a href="${pageContext.request.contextPath}/cursos">Cursos</a>
    <a href="${pageContext.request.contextPath}/docentes">Docentes</a>
    <a href="${pageContext.request.contextPath}/asignaturas">Asignaturas</a>
    <a href="${pageContext.request.contextPath}/horarios">Horarios</a>
    <a href="${pageContext.request.contextPath}/horario-docente">Horario docente</a>
    <a href="${pageContext.request.contextPath}/logout">Salir</a>
  </nav>
</header>
<main class="wrap"><h1>${pageTitle}</h1>
